# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# These power the contact form's SMTP email sending (server-side only).

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Your Gmail address.
SMTP_USER=you@gmail.com
# A Gmail *App Password* (16 chars), NOT your normal password.
# Create one at https://myaccount.google.com/apppasswords (2FA must be on).
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
SMTP_DISPLAY_NAME=Athr Website
# Inbox that receives contact-form messages (defaults to SMTP_USER).
CONTACT_TO=you@gmail.com
